datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  ADMIN
  SECRETARIA
  DOCENTE
  ESTUDIANTE
}

enum EducationLevelCode {
  INICIAL
  PRIMARIA
  SECUNDARIA
}

enum EnrollmentStatus {
  ACTIVE
  CANCELLED
}

model User {
  id           String   @id @default(uuid()) @db.Uuid
  email        String   @unique
  passwordHash String
  firstName    String
  lastName     String
  role         Role
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  student      Student?
  teacher      Teacher?
}

model EducationLevel {
  id        String             @id @default(uuid()) @db.Uuid
  code      EducationLevelCode @unique
  name      String
  isActive  Boolean            @default(true)
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt
  grades    Grade[]
}

model Grade {
  id               String         @id @default(uuid()) @db.Uuid
  educationLevelId String         @db.Uuid
  educationLevel   EducationLevel @relation(fields: [educationLevelId], references: [id])
  name             String
  order            Int
  isActive         Boolean        @default(true)
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  sections         Section[]

  @@unique([educationLevelId, order])
}

model AcademicPeriod {
  id          String       @id @default(uuid()) @db.Uuid
  name        String       @unique
  startDate   DateTime     @db.Date
  endDate     DateTime     @db.Date
  isActive    Boolean      @default(true)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  sections    Section[]
  enrollments Enrollment[]
}

model Section {
  id               String         @id @default(uuid()) @db.Uuid
  gradeId          String         @db.Uuid
  grade            Grade          @relation(fields: [gradeId], references: [id])
  academicPeriodId String         @db.Uuid
  academicPeriod   AcademicPeriod @relation(fields: [academicPeriodId], references: [id])
  name             String
  isActive         Boolean        @default(true)
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  enrollments      Enrollment[]

  @@unique([gradeId, academicPeriodId, name])
  @@unique([id, academicPeriodId])
}

model Student {
  id          String       @id @default(uuid()) @db.Uuid
  studentCode String       @unique
  firstName   String
  lastName    String
  birthDate   DateTime     @db.Date
  userId      String?      @unique @db.Uuid
  user        User?        @relation(fields: [userId], references: [id])
  isActive    Boolean      @default(true)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  enrollments Enrollment[]
}

model Teacher {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @unique @db.Uuid
  user      User     @relation(fields: [userId], references: [id])
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Enrollment {
  id               String           @id @default(uuid()) @db.Uuid
  studentId        String           @db.Uuid
  student          Student          @relation(fields: [studentId], references: [id])
  sectionId        String           @db.Uuid
  academicPeriodId String           @db.Uuid
  section          Section          @relation(fields: [sectionId, academicPeriodId], references: [id, academicPeriodId])
  academicPeriod   AcademicPeriod   @relation(fields: [academicPeriodId], references: [id])
  status           EnrollmentStatus @default(ACTIVE)
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  @@unique([studentId, academicPeriodId])
}
